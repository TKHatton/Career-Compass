# ====================
# SUPABASE CONFIGURATION
# ====================
# Get these from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your Supabase service role key (NEVER expose in browser, server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ====================
# ANTHROPIC CONFIGURATION
# ====================
# Get your API key from: https://console.anthropic.com/
# Used for CV tailoring, cover letters, and writing tools
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ====================
# EMAIL CONFIGURATION
# ====================
# Get your API key from: https://resend.com/api-keys
# Used for "email to self" features
RESEND_API_KEY=re_your-api-key-here

# Email address to send from (must be verified in Resend)
EMAIL_FROM=noreply@yourdomain.com

# ====================
# APPLICATION CONFIGURATION
# ====================
# Your application URL (for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
